import { Button, LineEdit, TextEdit, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "ECO UI-0 — Slint framework gate";
    width: 1366px;
    height: 768px;
    min-width: 1024px;
    min-height: 640px;
    background: #f4f7f6;

    in property <[string]> actions;
    callback search-changed(string);

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 64px;
            background: #123f3f;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;
                Text { text: "ECO"; color: white; font-size: 25px; font-weight: 700; vertical-alignment: center; }
                Text { text: "Evidence & Casework One"; color: #cbe5e1; font-size: 14px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text { text: "UI-0 architecture proof • synthetic only"; color: #cbe5e1; font-size: 12px; vertical-alignment: center; }
            }
        }

        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: root.width < 1180px ? 76px : 208px;
                background: #173f40;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Button { text: root.width < 1180px ? "W" : "Workspace"; }
                    Button { text: root.width < 1180px ? "E" : "Evidence"; }
                    Button { text: root.width < 1180px ? "C" : "Case structure"; }
                    Button { text: root.width < 1180px ? "T" : "Work"; }
                    Button { text: root.width < 1180px ? "R" : "Reports"; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Button { text: root.width < 1180px ? "⚙" : "Settings"; }
                }
            }

            ScrollView {
                horizontal-stretch: 1;
                viewport-width: self.width;
                VerticalLayout {
                    padding: 22px;
                    spacing: 14px;

                    HorizontalLayout {
                        Text { text: "General Casework 1\nMatter Workspace"; color: #173b3c; font-size: 22px; font-weight: 700; horizontal-stretch: 1; }
                        Text { text: "10 evidence  •  9 readable  •  1 unresolved"; color: #456565; font-size: 12px; vertical-alignment: center; }
                    }

                    Rectangle {
                        height: 112px;
                        border-width: 1px; border-color: #d3e1de; border-radius: 14px; background: white;
                        VerticalLayout {
                            padding: 16px; spacing: 8px;
                            Text { text: "What ECO found"; color: #173b3c; font-size: 18px; font-weight: 700; }
                            Text { text: "4 proposed Facts   •   1 person   •   1 organisation   •   1 communication\n1 issue   •   1 missing item   •   1 proposed task"; color: #315b59; font-size: 14px; }
                        }
                    }

                    Rectangle {
                        height: 154px;
                        border-width: 1px; border-color: #e7d7ac; border-radius: 14px; background: #fffdf8;
                        HorizontalLayout {
                            padding: 16px; spacing: 16px;
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 5px;
                                Text { text: "POSSIBLE MISSING EVIDENCE"; color: #8b6a1f; font-size: 11px; font-weight: 700; }
                                Text { text: "Written warranty confirmation"; color: #352d1a; font-size: 19px; font-weight: 700; }
                                Text { text: "The booking email says written confirmation will follow. ECO did not locate a separate confirmation in the readable evidence."; color: #554d3b; wrap: word-wrap; }
                                Text { text: "Coverage: 9/10 evidence records machine-readable • 1 image unresolved"; color: #7c725a; font-size: 11px; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Button { text: "Why does ECO think this?"; }
                                Button { text: "Review"; }
                            }
                        }
                    }

                    Rectangle {
                        height: 276px;
                        border-width: 1px; border-color: #d3e1de; border-radius: 14px; background: white;
                        VerticalLayout {
                            padding: 16px; spacing: 8px;
                            Text { text: "Actions & Questions"; color: #173b3c; font-size: 18px; font-weight: 700; }
                            LineEdit {
                                placeholder-text: "Search this Matter or ask ECO… Try ‘war’";
                                edited(text) => { root.search-changed(text); }
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 4px;
                                    for action in root.actions: Button { text: action; }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 300px;
                        border-width: 1px; border-color: #d3e1de; border-radius: 14px; background: white;
                        VerticalLayout {
                            padding: 16px; spacing: 8px;
                            HorizontalLayout {
                                Text { text: "Ask ECO"; color: #173b3c; font-size: 18px; font-weight: 700; horizontal-stretch: 1; }
                                Text { text: "Entire Matter • 10/10 considered • 1 unresolved"; color: #627777; font-size: 11px; }
                            }
                            TextEdit {
                                vertical-stretch: 1;
                                read-only: true;
                                wrap: word-wrap;
                                text: "You\nWhat is known, uncertain and missing?\n\nECO\nKnown: the booking email records an engineer visit for 29 July 2026.\n\nPossible gap: written warranty confirmation may still be outstanding.\n\nWhy this might be wrong: confirmation may exist outside the imported evidence or in the unresolved image.\n\nSources: 01_repair_booking_email.eml • 04_warranty_schedule.txt\n\nThis transcript must remain normally selectable and copyable.";
                            }
                            HorizontalLayout {
                                LineEdit { horizontal-stretch: 1; placeholder-text: "Ask about this Matter…"; }
                                Button { text: "Send"; }
                            }
                        }
                    }
                }
            }

            if root.width >= 1180px: Rectangle {
                width: 300px;
                background: #ebf2f0;
                border-width: 1px; border-color: #d1dedb;
                VerticalLayout {
                    padding: 18px; spacing: 10px;
                    Text { text: "Current position"; color: #173b3c; font-size: 17px; font-weight: 700; }
                    Text { text: "10 evidence records are linked. Four evidence-derived Facts await review. One possible warranty gap needs attention."; color: #405a5a; wrap: word-wrap; }
                    Text { text: "Next recommended action"; color: #173b3c; font-weight: 700; }
                    Text { text: "Review the possible missing warranty confirmation and its source."; color: #405a5a; wrap: word-wrap; }
                    Button { text: "Review next finding"; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Text { text: "UI-0 • framework comparison"; color: #718281; font-size: 10px; }
                }
            }
        }
    }
}
