<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Eco.Recovery.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style Selector="TextBlock.H1">
      <Setter Property="FontSize" Value="32" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LineHeight" Value="38" />
    </Style>
    <Style Selector="TextBlock.H2">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.H3">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.Eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="LetterSpacing" Value="1.2" />
    </Style>
    <Style Selector="TextBlock.Muted">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style Selector="Border.Card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #120B2A3A" />
    </Style>
    <Style Selector="Border.SubtleCard">
      <Setter Property="Background" Value="{DynamicResource SubtlePanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.Pill">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.Primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.Primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
    </Style>
    <Style Selector="Button.Secondary">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>
    <Style Selector="Button.Nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#C8DFE2" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.Nav:pointerover">
      <Setter Property="Background" Value="#1B4958" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.Nav.Selected">
      <Setter Property="Background" Value="#1D5862" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.Tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style Selector="Button.Tab.Selected">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="Padding" Value="11,9" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EEF3F6" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtlePanelBrush" Color="#F6F9FA" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#102A36" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5E737D" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D8E2E6" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#B8C9CF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0F766E" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#0A5B56" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCF4EF" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF1DC" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDE7E5" />
    <SolidColorBrush x:Key="DifferentBrush" Color="#6D4BC3" />
    <SolidColorBrush x:Key="DifferentSoftBrush" Color="#EEE8FF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0B2A3A" />
  </Application.Resources>
</Application>
